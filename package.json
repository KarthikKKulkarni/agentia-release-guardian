{
  "name": "agentia-release-guardian",
  "description": "Intelligent pre-deployment risk and governance analysis for Agentia CLI",
  "version": "0.1.0",
  "author": "KarthikKKulkarni",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "license": "MIT",
  "keywords": [
    "oclif-plugin",
    "agentia"
  ],
  "files": [
    "/dist",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@oclif/core": "^4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oclif": "^4",
    "shx": "^0.3.3",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "oclif": {
    "bin": "agentia",
    "dirname": "agentia-cli",
    "commands": "./dist/commands",
    "topics": {
      "guardian": {
        "description": "Guardian plugin commands"
      }
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "test": "vitest run",
    "clean": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest",
    "postpack": "npm run clean"
  }
}